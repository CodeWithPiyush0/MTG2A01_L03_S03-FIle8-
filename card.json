   "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
   "vo_t1_a": "आकाश और मोनी ब्लॉक्स से खेल रहे हैं, और ये सारे ब्लॉक्स मिलाकर एक ऊँची बिल्डिंग बना रहे हैं।",
   "vo_t1_ask": "चलिए, पता करते हैं, दोनों के पास मिलाकर कुल कितने ब्लॉक्स हैं?",
   "vo_t1_b": "आकाश के पास 23 ब्लॉक्स हैं और मोनी के पास 14 ब्लॉक्स हैं।",
   "vo_t2_build": "अब आप ब्लॉक्स की सहायता से 14 बनाइए।",
   "vo_t2_done": "इसलिए, 23 और 14 को जोड़ने पर 37 मिलता है।",
   "vo_t2_go": "बहुत बढ़िया! अब दोनों संख्याओं को जोड़ते हैं।",
   "vo_t2_head": "आइए, 23 और 14 को जोड़ते हैं।",
   "vo_t2_intro": "सबसे पहले ब्लॉक्स की सहायता से दोनों संख्याएँ बनाते हैं।",
   "vo_t2_o_add": "पहले इकाइयों को जोड़ते हैं।",
   "vo_t2_o_sum": "3 इकाई और 4 इकाई मिलाकर हुई, 7 इकाई।",
   "vo_t2_ones": "अब 3 इकाई के लिए 3 ब्लॉक रखते हैं।",
   "vo_t2_r1": "23 में 2 दहाई और 3 इकाई हैं।",
   "vo_t2_r2": "इसी तरह, 14 में 1 दहाई और 4 इकाई हैं।",
   "vo_t2_t_add": "अब दहाइयों को जोड़ते हैं।",
   "vo_t2_t_sum": "2 दहाई और 1 दहाई मिलाकर हुई, 3 दहाई।",
   "vo_t2_tens": "पहले 2 दहाई के लिए 2 बंडल रखते हैं।",
   "vo_t2_total": "अब हमारे पास कुल 3 दहाइयाँ और 7 इकाइयाँ हैं, यानी 37",
   "vo_t3_eq": "23 जोड़ 14 बराबर 37",
   "vo_t3_tot": "आकाश और मोनी के पास कुल मिलाकर 37 ब्लॉक्स हैं।"
  }
